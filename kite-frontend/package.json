{
  "name": "kite-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NEXT_PUBLIC_KITE_MODE=debug NEXT_PUBLIC_USE_MOCK=${NEXT_PUBLIC_USE_MOCK:-true} NEXT_PUBLIC_DEBUG_DIRECT_ROUTES=${NEXT_PUBLIC_DEBUG_DIRECT_ROUTES:-true} next dev --hostname 127.0.0.1 --port 5173",
    "stage": "NEXT_PUBLIC_KITE_MODE=staging NEXT_PUBLIC_USE_MOCK=false next dev --hostname 127.0.0.1 --port 5173",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "build:dev": "NEXT_PUBLIC_KITE_MODE=debug NEXT_PUBLIC_USE_MOCK=${NEXT_PUBLIC_USE_MOCK:-true} next build",
    "build:stage": "NEXT_PUBLIC_KITE_MODE=staging NEXT_PUBLIC_USE_MOCK=false next build",
    "build:prod": "NEXT_PUBLIC_KITE_MODE=production NEXT_PUBLIC_USE_MOCK=false next build",
    "start": "next start --hostname 0.0.0.0 --port ${PORT:-3000}",
    "lint": "eslint .",
    "test": "vitest run",
    "audit:metadata": "node scripts/audit-metadata.mjs",
    "audit:session": "node scripts/audit-session.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "antd": "^6.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.14",
    "next": "16.4.3",
    "@ant-design/nextjs-registry": "1.3.0",
    "ky": "2.2.0",
    "zod": "4.6.7",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
